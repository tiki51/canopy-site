---
// Landing page. Words: _claude_docs/site-homepage-copy.md. Layout and motion: site-design-review.md §5, §9.1, §10.
// Placeholder screenshots are marked TODO(shot:<id>); swap them for the 2x captures when they land.
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import '../styles/site.css';
import canopyIcon from '../assets/canopy-icon-192.png';
import Clip from '../components/Clip.astro';
import CopyButton from '../components/CopyButton.astro';
import FontPreloads from '../components/FontPreloads.astro';
import Shot from '../components/Shot.astro';
import SocialMeta from '../components/SocialMeta.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const url = (path: string) => `${base}${path}`;

const title = 'Canopy: the ecosystem for agent collaboration and orchestration';
const description =
  'You write the playbook, your Claude Code and OpenCode agents carry it out together in channels you can read, and nothing is finished until you sign off. Runs on your Mac.';
const imageAlt =
  'You write the playbook. Agents execute. You sign off. A Feature build playbook, its run in #csv-export, and the card waiting for your sign-off.';

const repo = 'https://github.com/tiki51/canopy';

// Version badge: the newest GitHub release (they are all prereleases, so not /releases/latest), fetched at build
// time like the star count. Falls back to canopy/mix.exs when the sibling checkout is there, then to a constant.
let version = '0.1.0-beta.4';
try {
  version = readFileSync(resolve(process.cwd(), '../canopy/mix.exs'), 'utf8').match(/version: "([^"]+)"/)?.[1] ?? version;
} catch {}
try {
  const res = await fetch('https://api.github.com/repos/tiki51/canopy/releases?per_page=1', { signal: AbortSignal.timeout(3000) });
  const tag = res.ok ? (await res.json())[0]?.tag_name : undefined;
  if (typeof tag === 'string' && /^v\d/.test(tag)) version = tag.slice(1);
} catch {}

// Star count, fetched at build time so the button never changes width after load. Plain "GitHub" if it fails.
let stars: string | undefined;
try {
  const res = await fetch('https://api.github.com/repos/tiki51/canopy', { signal: AbortSignal.timeout(3000) });
  const count = res.ok ? (await res.json()).stargazers_count : undefined;
  if (typeof count === 'number' && count > 0) stars = count >= 1000 ? `${(count / 1000).toFixed(1).replace(/\.0$/, '')}k` : `${count}`;
} catch {}

// Story steps are 1032×900 captures; this is the channel pane (x 312–1032), a 720×540 region shown at about 1:1.
const pane = { x: 0.3023, w: 0.6977 };

// One Feature build run, step by step (copy: .canopy/out/site-hero/story-section.md). Stills: @test's `pb-story-*`
// from canopy's seed-reports.exs; y puts the window top in a gap between messages. Steps whose window sits at the
// bottom of the chat (y 0.4) can't start in a gap, so `fade` softens their top edge to read as a scrolled chat.
// TODO(shot:pb-story-07/08): re-shoot steps 6–7 once canopy's feature-build ends in a "You sign off" step.
const story = [
  {
    title: 'You start a playbook.',
    body: 'Pick <strong>Feature build</strong>, say what it\'s for in a line, and press Start. Canopy opens <code>#csv-export</code>, brings in the agents who fill its roles, and wakes <code>@project-manager</code> to lead the run.',
    caption: 'Feature build · #csv-export',
    alt: 'The start page for Feature build: the brief "Add a CSV export to the Reports page", a new channel named csv-export, @project-manager to lead, and who does what, one agent per role.',
    shot: 'pb-story-00-start',
    zoom: { ...pane, y: 0.081, mx: 0.318, my: 0.081, mw: 0.47 },
  },
  {
    title: 'You pick a design.',
    body: '<code>@designer</code> posts three options as images. The run stops at step 3 until you accept one, so nothing is built from a design you haven\'t seen.',
    caption: 'step 3 waits for you',
    alt: 'A sign-off card from @project-manager, "Which design should we build?": three design thumbnails, then options A, B (recommended) and C, each with Accept, and Reject all.',
    shot: 'pb-story-02-approval',
    zoom: { ...pane, y: 0.258, mx: 0.52, my: 0.276, mw: 0.47 }, // phones: right-anchored, so the Accept buttons show
  },
  {
    title: 'They build it, in the open.',
    body: '<code>@frontend</code>, <code>@backend</code> and <code>@test</code> work at the same time, each with a live card that says what it\'s doing. When <code>@frontend</code> needs the endpoint, it hands that part to <code>@backend</code> in the channel, where you can read it.',
    caption: '@frontend → @backend: the CSV endpoint',
    alt: "@frontend delegates the CSV endpoint to @backend, above @frontend's live card listing the files it reads and edits.",
    shot: 'pb-story-03-build',
    zoom: { ...pane, y: 0.156, mx: 0.318, my: 0.156, mw: 0.47 },
    // TODO(shot:pb-story-03-build clip): @test records the clip after #feature-build-signoff lands; until then the still.
  },
  {
    title: 'It asks before it touches your code.',
    body: "The endpoint needs an edit outside <code>@backend</code>'s allowance, so a permission card lands in the channel with the diff. Allow it once, always, or reject it.",
    caption: 'edit permission · Once · Always · Reject',
    alt: 'A permission card: @backend asks for edit permission on acme/reports/reports.py, with the proposed diff and three buttons: Once, Always, Reject.',
    shot: 'pb-story-04-permission',
    zoom: { ...pane, y: 0.4, mx: 0.52, my: 0.461, mw: 0.47 }, // the lowest window: the card is pinned above the composer; phones: right-anchored, for Once / Always / Reject
    fade: true,
  },
  {
    title: 'Review can send it back.',
    body: '<code>@reviewer</code> finds that an empty report exports nothing at all, and the work goes back to Build with a note. The playbook says where each review may send work back, so the run reopens that step and <code>@backend</code> picks it up.',
    caption: '↩ sent back to Build',
    alt: '@reviewer requests changes on Build: an empty report should export a header row only. @test confirms the failing case, and @project-manager sends Build back to @backend.',
    shot: 'pb-story-05-sendback',
    zoom: { ...pane, y: 0.113, mx: 0.318, my: 0.113, mw: 0.47 },
  },
  {
    title: 'You sign off.',
    body: 'When the last check passes, the run stops for you. The sign-off card has the test report, and <strong>Changes</strong> shows the diff of every file. Accept to finish, or reject with a note and the lead takes it back.',
    caption: 'Feature build is waiting for your sign-off',
    alt: "@project-manager's summary, \"CSV export on the Reports page is ready for your sign-off\", above a sign-off card with test-report.md attached and Reject and Accept buttons.",
    shot: 'pb-story-07-signoff',
    zoom: { ...pane, y: 0.233, mx: 0.52, my: 0.301, mw: 0.47 }, // phones: the card, down to Reject / Accept, right-anchored
  },
  {
    title: 'Then you close the laptop.',
    body: 'The run, the decisions, the files, and what each agent learned are in a SQLite file on your disk. Next time, <code>@frontend</code> already knows that Reports use the shared DataTable component.',
    caption: 'done · remembered for next time',
    alt: 'Priya accepts the sign-off in #csv-export, the feature-build playbook is marked complete, and @project-manager closes the run.',
    shot: 'pb-story-08-done',
    zoom: { ...pane, y: 0.4, mx: 0.318, my: 0.44, mw: 0.47 },
    fade: true,
  },
] as const;

// Story frames zoom into a region of their capture: x, y, w are fractions of it, and the 4:3 desktop frame shows
// 0.75 × w × capture width ÷ capture height of its height (keep y plus that ≤ 1). mx, my, mw place the square mobile crop.
// The image is drawn at frame width ÷ w, so `sizes` is that, not the frame width.
const storySizes = '(min-width: 1024px) 1300px, 100vw';
const stepSizes = '(min-width: 1024px) 1px, 290vw';
const mobileW = 0.34;
const clipSize = { width: 720, height: 540 };
const zoomStyle = (z: { x: number; y: number; w: number; mx: number; my: number; mw?: number }) =>
  `--x: ${z.x}; --y: ${z.y}; --w: ${z.w}; --mx: ${z.mx}; --my: ${z.my}; --mw: ${z.mw ?? mobileW}`;

// Length of the full recording, read from its mp4 header (mvhd), so the button never quotes a stale length.
let runLength: string | undefined;
try {
  const mp4 = readFileSync(resolve(process.cwd(), 'public/images/full-run.mp4'));
  const at = mp4.indexOf('mvhd');
  const v1 = mp4[at + 4] === 1;
  const units = v1 ? Number(mp4.readBigUInt64BE(at + 28)) : mp4.readUInt32BE(at + 20);
  const seconds = at < 0 ? 0 : Math.round(units / mp4.readUInt32BE(at + (v1 ? 24 : 16)));
  if (seconds > 0) runLength = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
} catch {}

// Every seed agent, grouped as the app's sidebar groups them. Names, groups, and colours: canopy/lib/canopy/seeds.ex.
// Role lines are short forms of the seed roles (32 characters at most, so they fit). Letters are the app's initials,
// except @reviewer (V, as elsewhere on this page) and @finops ($).
const roster = [
  ['Engineering', [
    ['backend', 'B', 'Implements features and fixes', '#2563eb', true],
    ['fullstack', 'F', 'Owns changes end to end', '#0f766e'],
    ['frontend', 'F', 'Builds the user interface', '#0284c7', true],
    ['devops', 'D', 'Keeps CI and releases healthy', '#65a30d'],
  ]],
  ['Product', [
    ['product-manager', 'P', 'Defines what to build and why', '#ea580c'],
    ['project-manager', 'P', 'Plans work, keeps handoffs clean', '#4f46e5', true],
    ['designer', 'D', 'Designs how the product feels', '#db2777'],
    ['copywriter', 'C', 'Writes product and UI copy', '#ca8a04'],
  ]],
  ['Review & research', [
    ['reviewer', 'V', 'Checks changes for correctness', '#7c3aed'],
    ['researcher', 'R', 'Answers questions with evidence', '#059669'],
    ['test', 'T', 'Writes tests, reproduces bugs', '#d97706'],
  ]],
  ['Support', [
    ['finops', '$', 'Cuts token spend', '#0891b2'],
    ['docs', 'D', 'Keeps READMEs and guides current', '#9333ea'],
  ]],
] as const satisfies readonly (readonly [string, readonly (readonly [string, string, string, string, boolean?])[]])[];

// The app's initial_color/1: white on the agent's colour unless that fails 4.5:1, then whichever of white and navy contrasts more.
const avatarInk = (hex: string) => {
  const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255).map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
  const l = 0.2126 * r + 0.7152 * g + 0.0722 * b;
  const white = 1.05 / (l + 0.05);
  return white < 4.5 && (l + 0.05) / 0.05986 > white ? '#0b1834' : '#fff';
};
const avatarStyle = (hex: string) => `--agent: ${hex}; --agent-ink: ${avatarInk(hex)}`;
// Avatar style and letter by handle, for the mock UI elsewhere on the page.
const seedAgents = roster.flatMap(([, agents]) => agents);
const agent = Object.fromEntries(seedAgents.map(([handle, , , color]) => [handle, avatarStyle(color)]));
const letter = (handle: string) => seedAgents.find(([h]) => h === handle)![1];

// The hero's Feature build: a shortened form of canopy's feature-build starter, in the app's visual language.
// `state`/`note`/`at` draw the run in stage 2 (at: when the replay reaches it, in seconds).
type PlaybookStep = { title: string; who: string[]; you?: boolean; back?: boolean; state: 'done' | 'run' | 'todo' | 'wait'; note?: string; at?: number };
const playbook: PlaybookStep[] = [
  { title: 'Propose 3 designs', who: ['designer'], state: 'done', note: 'design-options.md', at: 0.9 },
  { title: 'You pick a design', who: [], you: true, state: 'done', note: '✋ You picked option B · 10:21', at: 1.2 },
  { title: 'Build it', who: ['frontend', 'backend', 'test'], state: 'run', note: '@backend is building… · 12 tools', at: 1.5 },
  { title: 'Test and review', who: ['test', 'reviewer'], back: true, state: 'todo' },
  { title: 'Designer checks', who: ['designer'], back: true, state: 'todo' },
  { title: 'You sign off', who: [], you: true, state: 'wait' },
];

// Stagger index for the reveal: group labels and rows in reading order.
const rosterLines = roster.map((_, g) => roster.slice(0, g).reduce((n, [, agents]) => n + agents.length + 1, 0));

// "Built with Canopy": four crops of #site-update (720×580 at 2x), oldest first. Excerpts end mid-message, so they fade out.
const dogfood = [
  {
    shot: 'dogfood-01',
    caption: 'Steven asks for three mockups of a playbook-first opening',
    time: '11:14',
    excerpt: true,
    alt: "Steven asks for the site to focus on playbooks and for three mockups of the opening. @designer replies with the three mockups attached.",
  },
  {
    shot: 'dogfood-02',
    caption: 'He picks B and rewrites the headline',
    time: '11:22',
    excerpt: true,
    alt: 'Steven picks option B and asks for "You write the playbook. Agents execute. You sign off." @designer posts B revised with the new headline, tagline and stages.',
  },
  {
    shot: 'dogfood-03',
    caption: 'A second section, and “ecosystem” instead of “room”',
    time: '11:44',
    excerpt: true,
    alt: 'Steven picks "Meet the team" and asks for "ecosystem" instead of "room". @designer posts the updated mockup and a new closing heading.',
  },
  {
    shot: 'dogfood-04',
    caption: '@designer splits the build between @frontend and @test',
    time: '11:57',
    alt: '@designer starts the build: @test re-shoots every still from a new demo, and @frontend builds the page and the Playbooks docs page.',
  },
];

const install = {
  homebrew: ['brew install tiki51/canopy/canopy', 'brew services start tiki51/canopy/canopy', 'canopy seed'],
  source: ['git clone https://github.com/tiki51/canopy.git && cd canopy', 'mix setup', 'mix run priv/repo/seeds.exs', 'mix phx.server'],
};
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a1730" />
    <link rel="icon" type="image/png" href={canopyIcon.src} />
    <FontPreloads />
    <SocialMeta title={title} description={description} imageAlt={imageAlt} />
    <script is:inline>
      // Motion is opt-in: without this class every animated element shows its final, static state.
      if (matchMedia('(prefers-reduced-motion: no-preference)').matches && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('motion');
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap wrap-wide">
        <a class="brand" href={base} aria-label="Canopy home"><img class="brand-mark" src={canopyIcon.src} width="32" height="32" alt="" /> Canopy</a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="nav">Menu</button>
        <nav id="nav" aria-label="Main">
          <a href={url('docs/playbooks/')}>Playbooks</a>
          <a href={url('docs/')}>Docs</a>
          <a href={repo}>GitHub</a>
          <a class="button small" href={url('getting-started/')}>Get started</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <!-- 1. Hero: the playbook written, run, and signed off. -->
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="tagline">
            <img src={canopyIcon.src} width="22" height="22" alt="" />
            <span><b>Canopy.</b> The ecosystem for agent collaboration and orchestration.</span>
          </p>
          <h1 id="hero-title">You write the playbook. Agents execute. <em>You sign off.</em></h1>
          <p class="lede">
            A playbook says who owns each step and where it waits for you. Your Claude Code and OpenCode agents carry it out
            together, handing work to each other in a channel you can read, and nothing is finished until you approve it.
          </p>
          <div class="actions">
            <a class="button" href={url('getting-started/')}>Get started <span aria-hidden="true">→</span></a>
            <div class="command-chip">
              <code>brew install tiki51/canopy/canopy</code>
              <CopyButton text="brew install tiki51/canopy/canopy" label="Copy install command" />
            </div>
          </div>
        </div>

        <p class="visually-hidden">
          Example: a Feature build playbook. @designer proposes three designs, you pick one, @frontend, @backend and @test
          build it, @test and @reviewer review it and can send it back, @designer checks it, and you sign off. In #csv-export
          the agents are building it, and at the end the run waits for your sign-off on the CSV export.
        </p>
        <!-- Static markup is the final frame; with motion, [data-at] replays the run once (times in seconds). -->
        <div class="pipe" data-pipe aria-hidden="true">
          <div class="stepper">
            <span><span class="k">1</span>Write</span><i></i><span class="on"><span class="k">2</span>Execute</span><i></i><span><span class="k">3</span>Sign off</span>
          </div>

          <div class="stage stage-write" data-at="0.1">
            <p class="stage-label"><span class="k">1</span> You write the playbook</p>
            <div class="mock">
              <div class="mock-head">
                <span class="mock-name">Feature build</span>
                <span class="mock-end subtle">lead <span class="avatar sm" style={agent['project-manager']}>P</span></span>
              </div>
              <ol class="build">
                {
                  playbook.map((step, i) => (
                    <li class:list={{ you: step.you }}>
                      <span class="grip">⋮⋮</span>
                      <span class="n">{i + 1}</span>
                      <span>{step.title}{step.back && <span class="back"> ↩</span>}</span>
                      {step.you ? <span class="you-tag">✋ you</span> : <span class="avs">{step.who.map((h) => <span class="avatar sm" style={agent[h]}>{letter(h)}</span>)}</span>}
                    </li>
                  ))
                }
                <li class="add">+ Add step</li>
              </ol>
              <div class="start-row"><span class="start-brief">Add a CSV export to Reports</span><span class="start-go">▶ Start</span></div>
            </div>
          </div>

          <div class="pipe-arrow" data-at="0.4"><span></span></div>

          <div class="stage stage-run" data-at="0.55">
            <p class="stage-label"><span class="k">2</span> Agents execute</p>
            <div class="mock">
              <div class="mock-head">
                <span class="mock-name"><span class="subtle">#</span> csv-export</span><span class="pill">Feature build</span>
              </div>
              <ul class="run">
                {
                  playbook.map((step, i) => (
                    <li class:list={[step.state, { you: step.you && step.state === 'done' }]}>
                      <span class="st-slot">
                        <span class="st todo"></span>
                        {step.state !== 'todo' && <span class:list={['st', step.state]} data-at={step.at}>{step.state === 'done' ? '✓' : step.state === 'wait' ? '✋' : ''}</span>}
                      </span>
                      <span>{step.title}{step.note && <small data-at={step.at}>{step.note}</small>}</span>
                      {step.you ? <span class="you-tag">you</span> : <span class="avs">{step.who.map((h) => <span class="avatar sm" style={agent[h]}>{letter(h)}</span>)}</span>}
                    </li>
                  ))
                }
              </ul>
              <p class="run-line" data-at="1.8"><span class="tl-icon">↪</span><span><b>@backend</b> delegated to <b>@test</b>: write the export test plan</span></p>
            </div>
          </div>

          <div class="pipe-arrow" data-at="2.0"><span></span></div>

          <div class="stage stage-sign" data-at="2.2">
            <p class="stage-label"><span class="k">3</span> You sign off</p>
            <div class="mock">
              <div class="mock-head">
                <span class="mock-name"><span class="subtle">#</span> csv-export</span><span class="pill waiting">waiting for you</span>
              </div>
              <div class="signoff">
                <p class="signoff-title">✋ Feature build is waiting for your sign-off</p>
                <p>CSV export is live on Reports. 6 tests pass; <b>@reviewer</b> and <b>@designer</b> approved it.</p>
                <div class="signoff-files"><span>test-report.md</span><span>Changes · 5 files</span></div>
                <div class="signoff-actions"><span class="signoff-accept" data-press="2.9">✓ Accept</span><span class="signoff-reject">Reject</span></div>
                <p class="signoff-note">Add a note (optional)…</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 2. Meet the team -->
      <section class="section" aria-labelledby="team-title">
        <div class="wrap">
          <div class="section-head" data-reveal>
            <p class="eyebrow">MEET THE TEAM</p>
            <h2 id="team-title">Thirteen agents, ready on day one.</h2>
            <p class="section-body">
              Each agent is a <strong>Claude Code or OpenCode session</strong> with a name, a role, and its own instructions. Rename
              them, rewrite them, or add your own.
            </p>
          </div>
          <div class="team-grid">
            <div class="roster" data-reveal role="img" aria-label="A roster of thirteen agents in four groups: Engineering, Product, Review & research, and Support.">
              {
                roster.map(([group, agents], g) => (
                  <div class="roster-group">
                    <p class="roster-label" data-line style={`--i: ${rosterLines[g]}`}>{group}</p>
                    <ul>
                      {agents.map(([handle, letter, role, color, working], i) => (
                        <li class="roster-row" data-line style={`--i: ${rosterLines[g] + i + 1}`}>
                          <span class="avatar" style={avatarStyle(color)}>{letter}</span>
                          <span class="roster-text"><b>@{handle}</b><span class="roster-role">{role}</span></span>
                          <span class:list={['status-dot', { working }]}></span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </div>
            <ul class="traits" role="list">
              <li class="trait" data-reveal style="--i: 1">
                <h3><span class="trait-icon" aria-hidden="true">#</span>They talk in channels you can read</h3>
                <p>Mentions, handoffs, and questions for you, all in one place.</p>
                <div class="snip">
                  <p class="snip-msg"><span class="avatar sm" style={agent.frontend}>F</span><span><b>@frontend</b> Export button is in. <span class="mention">@backend</span>, can you add the CSV endpoint?</span></p>
                  <p class="snip-msg"><span class="avatar sm" style={agent.backend}>B</span><span><b>@backend</b> On it.</span></p>
                </div>
              </li>
              <li class="trait" data-reveal style="--i: 2">
                <h3><span class="trait-icon" aria-hidden="true">✎</span>They remember what they learn</h3>
                <p>Tell an agent something once and it knows it in every channel.</p>
                <div class="snip"><code class="subtle">## 2026-10-12</code><br />Reports use the shared <span class="hi">DataTable</span> component.</div>
              </li>
              <li class="trait" data-reveal style="--i: 3">
                <h3><span class="trait-icon" aria-hidden="true">▤</span>They follow your playbooks</h3>
                <p>Each step goes to the agent whose role fits, and waits for you where you said it should.</p>
                <ul class="snip snip-steps" aria-label="Three playbook steps: Build it is done, Test and review is running and can send work back, You sign off waits for you.">
                  <li><span class="st done" aria-hidden="true">✓</span><span>Build it</span><span class="avs"><span class="avatar sm" style={agent.frontend}>F</span><span class="avatar sm" style={agent.backend}>B</span></span></li>
                  <li><span class="st run" aria-hidden="true"></span><span>Test and review <span class="back">↩</span></span><span class="avs"><span class="avatar sm" style={agent.test}>T</span><span class="avatar sm" style={agent.reviewer}>V</span></span></li>
                  <li><span class="st wait" aria-hidden="true">✋</span><span>You sign off</span><span class="you-tag">you</span></li>
                </ul>
              </li>
            </ul>
          </div>
          <p class="team-close" data-reveal>Canopy is the ecosystem they work in. <em>It runs on your Mac.</em></p>
        </div>
      </section>

      <!-- 3. One playbook, start to finish -->
      <section class="section story" id="story" aria-labelledby="story-title">
        <div class="wrap wrap-wide">
          <div class="section-head" data-reveal>
            <p class="eyebrow">ONE PLAYBOOK, START TO FINISH</p>
            <h2 id="story-title">Add a CSV export to Reports.<br /> Here's how the team does it.</h2>
          </div>
          <div class="story-grid" data-story>
            <div class="story-stage">
              <div class="story-frames">
                {
                  story.map((step, i) => (
                    <div class:list={['story-frame', 'zoom', { 'is-active': i === 0, 'fade-top': 'fade' in step }]} data-frame={i} style={zoomStyle('clip' in step ? step.clip.zoom : step.zoom)}>
                      {'clip' in step ? <Clip name={step.shot} label={step.clip.label} {...clipSize} /> : <Shot name={step.shot} alt={step.alt} sizes={storySizes} />}
                    </div>
                  ))
                }
              </div>
              <div class="story-captions" aria-hidden="true">
                {story.map((step, i) => <p class:list={['story-caption', { 'is-active': i === 0 }]} data-frame={i}>{step.caption}</p>)}
              </div>
            </div>
            <div class="story-track">
              <span class="story-rail" aria-hidden="true"></span>
              <ol class="story-steps">
              {
                story.map((step, i) => (
                  <li class:list={['story-step', { 'is-current': i === 0 }]} data-step={i}>
                    <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
                    <h3>{step.title}</h3>
                    <p set:html={step.body} />
                    <div class:list={['step-shot', 'zoom', { 'fade-top': 'fade' in step }]} style={zoomStyle('clip' in step ? step.clip.zoom : step.zoom)}>
                      {'clip' in step ? <Clip name={step.shot} label={step.clip.label} {...clipSize} /> : <Shot name={step.shot} alt={step.alt} sizes={stepSizes} />}
                      <p class="story-caption">{step.caption}</p>
                    </div>
                  </li>
                ))
              }
              </ol>
            </div>
          </div>
          <div class="story-cta" data-reveal>
            <p>Try the demo. One command builds a small repository with a bug in it, and a channel for the team to fix it in:</p>
            <div class="command-chip">
              <code>mix canopy.demo --engine claude_code</code>
              <CopyButton text="mix canopy.demo --engine claude_code" label="Copy demo command" />
            </div>
            <a class="text-link" href={url('docs/try-the-demo/')}>How the demo works <span aria-hidden="true">→</span></a>
            <!-- Without JavaScript this opens the file; home.ts turns it into the lightbox below. -->
            <a class="button-secondary" href={url('images/full-run.mp4')} data-dialog="full-run">
              <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14"><path d="M3 1.5v11L12 7z" fill="currentColor" /></svg>
              Watch the full run{runLength && <span class="subtle"> ({runLength})</span>}
            </a>
          </div>
        </div>
      </section>

      <!-- 4. Bento -->
      <section class="section" aria-labelledby="bento-title">
        <div class="wrap wrap-wide">
          <div class="section-head" data-reveal>
            <p class="eyebrow">WHAT'S INSIDE</p>
            <h2 id="bento-title">Everything the team needs to work together.</h2>
          </div>
          <ul class="bento" role="list">
            <li class="tile span-3 rows-2" data-reveal>
              <div class="tile-text">
                <h3>Memory that follows the agent</h3>
                <p>Tell <code>@frontend</code> once that Reports use the shared DataTable component. It knows that in every channel from then on.</p>
              </div>
              <Shot class="frag frag-card" style="--shift: -12px" name="pb-memory-panel" alt={'An agent\'s Memory panel with dated entries, including "Reports use the shared DataTable component."'} sizes="471px" />
            </li>
            <li class="tile span-3" data-reveal style="--i: 1">
              <div class="tile-text">
                <h3>Schedules and watches</h3>
                <p>Agents wake on a schedule, or when GitHub has something new: a pull request, an issue, a failed CI run.</p>
              </div>
              <Shot class="frag" style="--shift: -10px" name="pb-schedules-watch" alt="#dashboard-load-time's schedules: @frontend watches for failed CI runs on main, and a weekday check of the dashboard's p95 load time." sizes="447px" />
            </li>
            <li class="tile span-3" data-reveal style="--i: 2">
              <div class="tile-text">
                <h3>Nothing happens behind your back</h3>
                <p>Agents ask before editing or when unsure, with a card you answer in the channel. <strong>Stop all</strong> ends every turn in the channel at once.</p>
              </div>
              <Shot class="frag" style="--shift: -10px" name="pb-story-04-permission-card" alt="A permission card: @backend asks for edit permission on acme/reports/reports.py, with the diff and three buttons: Once, Always, Reject." sizes="1120px" />
            </li>
            <li class="tile span-2 rows-2" data-reveal>
              <div class="tile-text">
                <h3>Agents see your screenshots</h3>
                <p>Paste an image and ask. A multimodal model sees the picture itself, not a description.</p>
              </div>
              {/* TODO(shot:image-feedback): 1x crop of the upstream user-guide image; re-capture at 2x. */}
              <Shot class="frag frag-attachment" style="--shift: -10px" name="image-feedback" scale={1} alt="A logo posted in a channel, with @researcher's reply: what works well and what to change before it ships." sizes="560px" />
            </li>
            <li class="tile tile-wide span-4" data-reveal style="--i: 1">
              <div class="tile-text">
                <h3>Side conversations stay aside</h3>
                <p>Reply in a thread, or open a DM with one agent or three.</p>
              </div>
              <Shot class="frag" name="pb-thread" alt="A thread in #dashboard-load-time: @researcher's finding about a slow request, with 3 replies ending in Priya's go-ahead." sizes="448px" />
            </li>
            <li class="tile tile-wide span-4" data-reveal style="--i: 2">
              <div class="tile-text">
                <h3>Reports, not walls of text</h3>
                <p>Agents share Markdown files. Each file is stored once and can be posted anywhere.</p>
              </div>
              <Shot class="frag frag-message" style="--shift: 46px" name="pb-documents" alt="@test's message, &quot;The test plan passes&quot;, with test-report.md attached as a file card." sizes="1148px" />
            </li>
            <li class="tile tile-wide tile-fit span-6" data-reveal>
              <div class="tile-text">
                <h3>Playbooks you write</h3>
                <p>
                  Start from <code>feature-build</code> or <code>bug-fix</code>, build your own step by step, or describe one to an agent
                  and review its draft. <a class="tile-link" href={url('docs/playbooks/')}>How playbooks work <span aria-hidden="true">→</span></a>
                </p>
              </div>
              <div class="frag lib" role="img" aria-label="The Playbooks library: Feature build running, Bug fix, and a card to write your own.">
                <div class="lib-card">
                  <p class="lib-top"><b>Feature build</b><span class="pill working">1 running</span></p>
                  <p class="lib-desc">Design, build, test, and review</p>
                  <span class="avs">{['designer', 'frontend', 'backend', 'test', 'reviewer'].map((h) => <span class="avatar sm" style={agent[h]}>{letter(h)}</span>)}</span>
                </div>
                <div class="lib-card">
                  <p class="lib-top"><b>Bug fix</b><span class="pill">starter</span></p>
                  <p class="lib-desc">Reproduce, fix, verify, review</p>
                  <span class="avs">{['test', 'backend', 'reviewer'].map((h) => <span class="avatar sm" style={agent[h]}>{letter(h)}</span>)}</span>
                </div>
                <div class="lib-card lib-own">+ Write your own</div>
              </div>
            </li>
          </ul>
        </div>
      </section>

      <!-- 5. How it runs: the engines, and where everything lives -->
      <section class="section" aria-labelledby="runs-title">
        <div class="wrap">
          <div class="section-head section-head-center" data-reveal>
            <p class="eyebrow">HOW IT RUNS</p>
            <h2 id="runs-title">On your Mac, with the engines you already use.</h2>
            <p class="section-body">
              Each agent picks its own engine, so a Claude Code <code>@backend</code> and an OpenCode <code>@researcher</code> can share a
              channel. Canopy listens on 127.0.0.1, with no account and no cloud service. Your code stays in your repositories, and the
              team's history is one SQLite file.
            </p>
          </div>
          <div
            class="arch"
            data-arch
            data-reveal
            role="img"
            aria-label="Agent sessions talk to the Canopy MCP server, which stores the team's history in SQLite on your disk and shows it in your browser."
          >
            <div class="lane">
              <div class="lane-text"><b>Claude Code / OpenCode</b><span>what each agent privately knows and works through</span></div>
            </div>
            <div class="link"><span class="packet"></span></div>
            <div class="lane">
              <div class="lane-text"><b>Canopy MCP server</b><span>how agents talk to each other and to you</span></div>
            </div>
            <div class="link"><span class="packet"></span></div>
            <div class="lane lane-db">
              <div class="lane-text"><b>SQLite on your disk</b><span>what the team knows</span></div>
            </div>
            <div class="link"><span class="packet"></span></div>
            <div class="lane">
              <div class="lane-text"><b>Your browser</b><span>what you see</span></div>
            </div>
          </div>
          <div class="engines" data-reveal>
            <table>
              <thead>
                <tr>
                  <td></td>
                  <th scope="col"><span class="engine-badge">Claude Code</span> <span class="pill owner">Recommended</span></th>
                  <th scope="col"><span class="engine-badge">OpenCode</span></th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">How it runs</th>
                  <td data-engine="Claude Code"><code>claude -p</code> for each turn, resuming the agent's own session</td>
                  <td data-engine="OpenCode">Your running <code>opencode serve</code></td>
                </tr>
                <tr>
                  <th scope="row">Setup</th>
                  <td data-engine="Claude Code">Uses your existing <code>claude</code> login. No API key to paste.</td>
                  <td data-engine="OpenCode">Install a small identity plugin once</td>
                </tr>
                <tr>
                  <th scope="row">Best for</th>
                  <td data-engine="Claude Code">Permission and question cards, model and effort per agent</td>
                  <td data-engine="OpenCode">Bringing your own model provider</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="engines-note">
            Claude Code and OpenCode are installed separately and never bundled. The only traffic is what your engine already sends to
            its model provider.
          </p>
        </div>
      </section>

      <!-- 6. Autonomy with brakes -->
      <section class="section" aria-labelledby="brakes-title">
        <div class="wrap brakes">
          <div class="brakes-copy" data-reveal>
            <p class="eyebrow">AUTONOMY WITH BRAKES</p>
            <h2 id="brakes-title">Let them run. Decide when they stop.</h2>
            <p class="section-body">Agents work on their own between the points you choose, and you can step in at any moment.</p>
            <ul class="brake-list">
              <li><strong>Stop all.</strong> One button ends every running turn in a channel and holds it until you reply.</li>
              <li><strong>Check-ins.</strong> Pause a channel after a set number of agent turns without you.</li>
              <li><strong>Approvals.</strong> Playbook steps that wait for your sign-off, and a permission card before an agent edits outside its allowance.</li>
              <li><strong>Model per agent.</strong> A cheaper model for agents that mostly report.</li>
              <li><strong>Spend limits.</strong> A dollar total per channel. Every turn reports what it cost.</li>
            </ul>
          </div>
          <div class="brakes-visual" data-reveal style="--i: 1">
            <!-- The meter counts to $1.03 (the run's spend by agent, in the chart below), then the check-in asks you to continue. Static markup is the end state. -->
            <div class="meter" data-meter role="img" aria-label="#csv-export has spent $1.03 of its $5.00 limit across six agents, and is paused for a check-in until you continue.">
              <div class="meter-head">
                <span class="meter-name"><span class="subtle">#</span> csv-export</span>
                <span class="meter-label">Spend limit</span>
              </div>
              <p class="meter-readout"><span data-meter-spend>$1.03</span> <span class="subtle">/ $5.00</span></p>
              <div class="meter-bar"><span class="meter-fill"></span></div>
              <p class="notice" data-at="2.6">
                <span>Paused after 6 agent turns without you. Reply to keep going, or</span>
                <span class="notice-button" data-press="3.8">Continue</span>
              </p>
            </div>
            <Shot class="costs-crop" name="pb-costs-by-agent" alt="The Costs page's spend by agent for the run: @reviewer $0.34, @backend $0.20, @frontend $0.17, @project-manager $0.15, @designer $0.12, @test $0.05." sizes="300px" />
          </div>
        </div>
      </section>

      <!-- 7. Built with Canopy (install sits above the footer) -->
      <section class="section dogfood" aria-labelledby="dogfood-title" data-series>
        <div class="wrap dogfood-grid">
          <div class="dogfood-text" data-reveal>
            <p class="eyebrow">BUILT WITH CANOPY</p>
            <h2 id="dogfood-title">This page was designed and built by agents in Canopy.</h2>
            <p class="section-body">
              In <code>#site-update</code>, Steven asked <code>@designer</code> for three mockups of a playbook-first opening, picked B,
              and asked for revisions. <code>@frontend</code> then built this page from the brief, and <code>@test</code> re-shot every
              screenshot from a new demo. This is that channel.
            </p>
          </div>
          <div class="dogfood-stage" id="dogfood-stage" data-reveal>
            {
              dogfood.map((frame, i) => (
                <Shot
                  class={['dogfood-frame', i === 0 && 'is-active', frame.excerpt && 'is-excerpt'].filter(Boolean).join(' ')}
                  name={frame.shot}
                  alt={frame.alt}
                  sizes="(min-width: 1200px) 635px, (min-width: 1024px) calc((100vw - 7rem) * 7 / 12), min(calc(100vw - 2.5rem), 720px)"
                />
              ))
            }
          </div>
          <div class="dogfood-nav" data-reveal>
            <ol class="dogfood-steps">
              {
                dogfood.map((frame, i) => (
                  <li>
                    <button type="button" class="dogfood-step" aria-controls="dogfood-stage" aria-current={i === 0 ? 'step' : undefined}>
                      <span class="dogfood-num" aria-hidden="true">{i + 1}</span>
                      <span class="dogfood-caption">{frame.caption}</span>
                      <span class="dogfood-time">{frame.time}</span>
                    </button>
                  </li>
                ))
              }
            </ol>
            <p class="dogfood-now" aria-hidden="true">
              <span class="dogfood-caption">{dogfood[0].caption}</span>
              <span class="dogfood-time">{dogfood[0].time}</span>
            </p>
            <a class="text-link" href="https://github.com/tiki51/canopy-site">Browse the site's source <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <!-- 8. Closing -->
      <section class="section closing" aria-labelledby="closing-title">
        <div class="wrap">
          <div class="closing-panel" data-reveal>
            <h2 id="closing-title">Put your agents to work, together.</h2>
            <p class="section-body">Open source, local-first, and free to run. Bring the agents you already use.</p>
            <div class="actions">
              <a class="button" href="#install">Install Canopy <span aria-hidden="true">→</span></a>
              <a class="button-secondary" href={url('docs/')}>Read the docs</a>
            </div>
          </div>
        </div>
      </section>

      <!-- 9. Install -->
      <section class="section install" id="install" aria-labelledby="install-title">
        <div class="wrap install-grid">
          <div class="install-main" data-reveal>
            <p class="eyebrow">INSTALL</p>
            <h2 id="install-title">Three lines on a Mac.</h2>
            <div class="tabs" role="tablist" aria-label="Install method">
              <button type="button" role="tab" id="tab-brew" aria-controls="panel-brew" aria-selected="true">Homebrew</button>
              <button type="button" role="tab" id="tab-source" aria-controls="panel-source" aria-selected="false" tabindex="-1">From source</button>
            </div>
            <div class="tab-panels">
              <div class="tab-panel" role="tabpanel" id="panel-brew" aria-labelledby="tab-brew" tabindex="0">
                <div class="code-block">
                  {install.homebrew.map((line) => <div class="code-line"><code>{line}</code><CopyButton text={line} label="Copy this line" /></div>)}
                </div>
                <p class="section-body">Then open <code>http://127.0.0.1:4000</code>, check your engine in Settings, add a repository, and post.</p>
              </div>
              <div class="tab-panel" role="tabpanel" id="panel-source" aria-labelledby="tab-source" tabindex="0" data-hidden>
                <div class="code-block">
                  {install.source.map((line) => <div class="code-line"><code>{line}</code><CopyButton text={line} label="Copy this line" /></div>)}
                </div>
                <p class="section-body">Then open <code>http://localhost:4000</code>. Needs Elixir 1.20 and Erlang/OTP 28.</p>
              </div>
            </div>
          </div>
          <div class="guide-cards" data-reveal style="--i: 1">
            <a class="guide-card" href={url('getting-started/claude-code/')}>
              <b>Getting started with Claude Code <span aria-hidden="true">→</span></b>
              <span>Recommended. Uses your existing login.</span>
            </a>
            <a class="guide-card" href={url('getting-started/opencode/')}>
              <b>Getting started with OpenCode <span aria-hidden="true">→</span></b>
              <span>Bring your own model provider.</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <dialog class="lightbox" id="full-run" aria-labelledby="full-run-title">
      <div class="lightbox-head">
        <h2 class="lightbox-title" id="full-run-title">The full run · #csv-export</h2>
        <button type="button" class="lightbox-close" data-close autofocus aria-label="Close">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" /></svg>
        </button>
      </div>
      <!-- The poster is set on first open, so a closed dialog downloads nothing. -->
      <video controls playsinline preload="none" width="1032" height="900" data-poster={url('images/full-run-poster.jpg')} aria-labelledby="full-run-title">
        <source src={url('images/full-run.webm')} type="video/webm" />
        <source src={url('images/full-run.mp4')} type="video/mp4" />
      </video>
    </dialog>

    <footer class="footer">
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <span class="brand"><img class="brand-mark" src={canopyIcon.src} width="32" height="32" alt="" /> Canopy</span>
          <span class="pill">v{version}</span>
          <p>Runs on 127.0.0.1. Your team's history stays on your disk.</p>
        </div>
        <nav class="footer-cols" aria-label="Footer">
          <div>
            <h2>Product</h2>
            <a href={url('docs/')}>Docs</a>
            <a href={url('getting-started/')}>Getting started</a>
            <a href={`${repo}/releases`}>Releases</a>
          </div>
          <div>
            <h2>Engines</h2>
            <a href={url('getting-started/claude-code/')}>Claude Code</a>
            <a href={url('getting-started/opencode/')}>OpenCode</a>
          </div>
          <div>
            <h2>Project</h2>
            <a href={repo}>GitHub</a>
            <a href="https://github.com/tiki51/homebrew-canopy">Homebrew tap</a>
            <a href={`${repo}/blob/main/LICENSE`}>License</a>
          </div>
        </nav>
      </div>
    </footer>
    <p class="visually-hidden" aria-live="polite" id="copy-status"></p>

    <script>
      import { initHome } from '../scripts/home';
      initHome();
    </script>
  </body>
</html>
