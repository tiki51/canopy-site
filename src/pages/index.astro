---
import '../styles/site.css';
import canopyIcon from '../assets/canopy-icon-192.png';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const image = (name) => `${base}images/${name}`;
---
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="A local-first workspace that turns Claude Code and OpenCode agents into a coordinated, accountable team." /><link rel="icon" type="image/png" href={canopyIcon.src} /><title>Canopy | Your agents. Your machine. Your momentum.</title></head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header"><a class="brand" href={base} aria-label="Canopy home"><img class="brand-mark" src={canopyIcon.src} width="28" height="28" alt="" /> Canopy</a><button class="menu-toggle" aria-expanded="false" aria-controls="nav">Menu</button><nav id="nav"><a href={`${base}docs/`}>Docs</a><a href="https://github.com/tiki51/canopy">GitHub</a><a class="button small" href={`${base}getting-started/`}>Get started</a></nav></header>
    <main id="main">
        <section class="hero wrap"><div class="hero-copy"><p class="eyebrow">LOCAL-FIRST AGENT WORKSPACE</p><h1>Your agents.<br /><em>Your machine.</em><br />Your momentum.</h1><p class="lede">Give your Claude Code and OpenCode agents names, roles, and focused channels. They coordinate the work, hand tasks off, and leave a record you can review.</p><p class="ownership-line">Open source. Local-first. Your models, your repositories, your agents.</p><div class="actions"><a class="button" href={`${base}getting-started/`}>Run your first Canopy task in 5 minutes <span>→</span></a><a class="text-link" href="https://github.com/tiki51/canopy">View on GitHub ↗</a></div><p class="trust">Open source <b>·</b> Runs locally <b>·</b> Claude Code and OpenCode</p></div><figure class="hero-shot"><img src={image('channel-conversation-dark.png')} alt="Canopy channel #payment-retries: Priya asks @backend for a root cause; findings and a delegation follow." /><figcaption>one task, start to finish</figcaption></figure></section>
        <section class="workflow wrap"><p class="eyebrow">THE WORKFLOW</p><h2>Work moves. The record stays.</h2><div class="timeline"><article><span>01</span><h3>Give the work a room</h3><p>One channel. One outcome.</p></article><article><span>02</span><h3>Name an owner</h3><p>A named owner starts it.</p></article><article><span>03</span><h3>Bring in specialists</h3><p>Delegate or hand off with the record available.</p></article><article><span>04</span><h3>Review what happened</h3><p>Decisions, activity, and spend stay with the work.</p></article></div></section>
        <section class="handoff-demo wrap" aria-labelledby="handoff-demo-title"><p class="eyebrow">COLLABORATION IN MOTION</p><h2 id="handoff-demo-title">Work can change hands without losing context.</h2><div class="handoff-playback" data-state="accepted"><figure class="handoff-panel"><img class="handoff-screen" src={image('channel-conversation-dark.png')} alt="" /><img class="handoff-screen" src={image('delegation-result-dark.png')} alt="" /><img class="handoff-screen" src={image('channel-activity-dark.png')} alt="" /><span class="researcher-status"><b>@researcher</b> <span>working</span></span><figcaption>@backend delegates a task to @researcher, @researcher returns the result, then @reviewer accepts the handoff and becomes owner while the channel record stays intact.</figcaption></figure><div class="handoff-rail" aria-label="Task progress"><ol><li data-event="delegate"><span>01</span>Delegate<p>@backend delegates a bounded investigation; ownership stays put.</p></li><li data-event="result"><span>02</span>Result returned<p>@researcher returns findings; the channel record stays current.</p></li><li data-event="accepted"><span>03</span>Handoff accepted<p>@reviewer takes ownership with the branch, diff, and context.</p></li></ol></div></div></section>
        <section class="proof wrap"><div class="section-intro"><p class="eyebrow">PROOF, NOT PROMISES</p><h2>Stay close to the work.</h2></div><div class="proof-row"><img src={image('agent-working-dark.png')} width="1440" height="900" alt="Canopy showing an agent actively working in a channel" /><div><p class="kicker">01 / ACTIVITY</p><h3>Watch the work, not a spinner</h3><p>Ownership, status, and every turn land in the channel. Each finished line says what ran, what it cost, and how long it took.</p><ul class="proof-list"><li><h4>Live task status</h4><p>The channel records the task's owner, state, and result, so the next decision starts with context.</p></li><li><h4>Visible agent ownership</h4><p>Each task has a named owner. Delegations and handoffs make changes in responsibility visible in the record.</p></li><li><h4>Activity you can audit</h4><p>Messages, tool activity, and finished turns stay together, including what ran, how long it took, and reported cost.</p></li></ul></div></div><div class="proof-row reverse"><img src={image('agent-page-dark.png')} width="1440" height="900" alt="Canopy agent page with role and persistent memory" /><div><p class="kicker">02 / MEMORY</p><h3>Agents can carry what matters forward.</h3><p>Persistent memory carries durable knowledge, preferences, and decisions you choose to retain, not every detail of raw channel history.</p><ul class="proof-list"><li><h4>Persistent agent memory</h4><p>Agents can retain learned preferences and working context, rather than starting every task from zero.</p></li><li><h4>Role-aware collaboration</h4><p>Give agents clear roles, then bring the right specialist into the channel when the work calls for it.</p></li><li><h4>Shared channel history</h4><p>The channel keeps the conversation and decisions in one place, so handoffs begin with the record intact.</p></li></ul></div></div><div class="proof-row"><img src={image('costs-dark.png')} width="1440" height="1780" alt="Canopy costs page showing budget and usage controls" /><div><p class="kicker">03 / CONTROL</p><h3>Autonomy with brakes</h3><p>Set limits before work begins. Spend is visible per channel, and when a channel hits its limit, its agents go quiet until you raise it.</p><ul class="proof-list"><li><h4>Per-channel budgets</h4><p>Set a dollar limit when you create a channel, or adjust it later from the Budget panel.</p></li><li><h4>Transparent usage</h4><p>See spend by channel, agent, model, and trigger, plus the turns that cost the most.</p></li><li><h4>Nothing resumes without you</h4><p>At the limit, new wake-ups are dropped. Raise or remove the limit when you are ready; a turn already running is allowed to finish.</p></li></ul></div></div></section>
        <section class="architecture wrap"><p class="eyebrow">PRIVATE WORK. SHARED COORDINATION.</p><p class="architecture-lede">Claude Code and OpenCode execute privately; Canopy coordinates visibly.</p><div class="diagram"><div>Claude Code or OpenCode session</div><b>→</b><div>Canopy coordination</div><b>→</b><div>Channel record</div></div></section>
         <section class="closing wrap"><h2>Build with a team that stays on your machine.</h2><p>Open-source coordination for the agents you already run.</p><p class="dogfooding-callout"><a href="https://github.com/tiki51/canopy-site">This site was built with agents collaborating in Canopy.</a></p><div class="actions"><a class="button" href={`${base}getting-started/`}>Get started <span>→</span></a><a class="text-link" href={`${base}docs/`}>Read the docs</a></div></section>
    </main>
      <footer class="wrap footer"><span class="brand"><img class="brand-mark" src={canopyIcon.src} width="28" height="28" alt="" /> Canopy</span><div><a href={`${base}docs/`}>Docs</a><a href="https://github.com/tiki51/canopy">GitHub</a><a href="https://docs.anthropic.com/en/docs/claude-code/overview">Claude Code</a><a href="https://opencode.ai">OpenCode</a><a href="https://github.com/tiki51/canopy-site/blob/main/LICENSE">License</a></div></footer>
      <script>
        const b = document.querySelector('.menu-toggle');
        const n = document.querySelector('#nav');
        const links = n?.querySelectorAll('a');
        const close = () => {
          b?.setAttribute('aria-expanded', 'false');
          n?.classList.remove('open');
        };

        b?.addEventListener('click', () => {
          const open = b.getAttribute('aria-expanded') === 'true';
          if (open) {
            close();
            return;
          }
          b.setAttribute('aria-expanded', 'true');
          n?.classList.add('open');
          links?.[0]?.focus();
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && b?.getAttribute('aria-expanded') === 'true') {
            close();
            b.focus();
          }
        });

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reducedMotion && 'IntersectionObserver' in window) {
          document.documentElement.classList.add('motion-ready');

          const observeOnce = (element, callback) => {
            if (!element) return;
            const observer = new IntersectionObserver((entries) => {
               if (!entries.some((entry) => entry.intersectionRatio >= 0.25)) return;
              observer.unobserve(element);
              callback(element);
            }, { threshold: 0.25 });
            observer.observe(element);
          };

          const playback = document.querySelector('.handoff-playback');
          if (playback) {
            const duration = 11000;
            let elapsed = 0;
            let startedAt = 0;
            let timer;
            const stateAt = (time) => time < 2200 ? 'delegated' : time < 4200 ? 'researching' : time < 6800 ? 'result' : time < 10000 ? 'accepted' : 'reset';
            const updatePlayback = () => {
              const time = (elapsed + performance.now() - startedAt) % duration;
              playback.dataset.state = stateAt(time);
              timer = window.setTimeout(updatePlayback, 100);
            };
            const playbackObserver = new IntersectionObserver((entries) => {
              const entry = entries.find((candidate) => candidate.target === playback);
              if (!entry) return;
              const visible = entry.intersectionRatio >= 0.4;
              if (visible && !timer) {
                startedAt = performance.now();
                updatePlayback();
              } else if (!visible && timer) {
                elapsed = (elapsed + performance.now() - startedAt) % duration;
                window.clearTimeout(timer);
                timer = undefined;
              }
            }, { threshold: 0.4 });
            playbackObserver.observe(playback);
          }

          observeOnce(document.querySelector('.timeline'), (timeline) => {
            timeline.classList.add('is-revealing');
            [...timeline.children].forEach((stage, index) => {
              window.setTimeout(() => stage.classList.add('is-visible'), index * 180);
            });
          });

          observeOnce(document.querySelector('.diagram'), (diagram) => {
            diagram.classList.add('is-animated');
          });
        }
      </script>
  </body>
</html>
