---
// Copy-to-clipboard button. The click handler lives in the landing page script ([data-copy]).
// The icon and the "Copied" label share one grid cell, so the button never changes width.
interface Props {
  text: string;
  label: string;
}

const { text, label } = Astro.props;
---

<button type="button" class="copy" data-copy={text} aria-label={label}>
  <svg class="copy-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
    <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.3"></rect>
    <path d="M10.5 3.5v-.5a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 3v5A1.5 1.5 0 0 0 4 9.5h.5" fill="none" stroke="currentColor" stroke-width="1.3"></path>
  </svg>
  <span class="copy-done" aria-hidden="true">Copied</span>
</button>
