---
// Open Graph and Twitter tags for the landing page. Starlight emits its own og:title/description
// for docs pages; the docs get og:image from the `head` entry in astro.config.mjs.
interface Props {
  /** og:title / twitter:title. */
  title: string;
  description: string;
  imageAlt?: string;
}

const { title, description, imageAlt = 'Canopy: your coding agents, working as a team.' } = Astro.props;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const url = new URL(path, Astro.site);
const image = new URL(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}og-card.png`, Astro.site);
---

<link rel="canonical" href={url} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Canopy" />
<meta property="og:url" content={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
